{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dataCollectionRuleName": {
      "type": "string",
      "defaultValue": "WinEvents-2-BlobStorage-DCR"
    },
    "storageAccountResourceId": {
      "type": "string"
    },
    "identityResourceId": {
      "type": "string"
    },
    "containerName": {
      "type": "string",
      "defaultValue": "secwineventsblob"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionRuleName')]",
      "location": "[parameters('location')]",
      "kind": "AgentDirectToStore",
      "properties": {
        "dataSources": {
          "windowsEventLogs": [
            {
              "streams": [
                "Microsoft-Event"
              ],
              "xPathQueries": [
                "Security!*[System[(EventID=4624) or (EventID=4625) or (EventID=4673) or (EventID=4685) or (EventID=1102)]]"
              ],
              "name": "eventLogsDataSource"
            }
          ]
        },
        "destinations": {
          "storageBlobsDirect": [
            {
              "containerName": "[parameters('containerName')]",
              "storageAccountResourceId": "[parameters('storageAccountResourceId')]",
              "identity": {
                "userAssignedIdentity": {
                  "identityId": "[parameters('identityResourceId')]"
                }
              },
              "name": "SecurityEventsBlob"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Microsoft-Event"
            ],
            "destinations": [
              "SecurityEventsBlob"
            ]
          }
        ]
      }
    }
  ]
}
